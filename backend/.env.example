APP_NAME="AutoExplain AI"
ENV=local
DEBUG=true

# Pick one provider and fill in its key
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
LLM_MODEL=claude-sonnet-4-6

OCR_ENGINE=tesseract

DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/autoexplain
EMBEDDING_MODEL=text-embedding-3-small

MAX_UPLOAD_MB=15
