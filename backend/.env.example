APP_NAME="AutoExplain AI"
ENV=local
DEBUG=true

# Pick one provider and fill in its key.
# groq is FREE (no card required) — get a key at console.groq.com
# anthropic / openai are paid, pay-as-you-go
LLM_PROVIDER=groq
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
LLM_MODEL=claude-sonnet-4-6
GROQ_MODEL=llama-3.3-70b-versatile

OCR_ENGINE=tesseract

DATABASE_URL=sqlite:///./autoexplain.db
EMBEDDING_MODEL=text-embedding-3-small

MAX_UPLOAD_MB=15
